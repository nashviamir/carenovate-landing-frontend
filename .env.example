# ─── Local development (npm run dev) ─────────────────────────────────────────
# Copy to `.env`. Postgres comes from `docker compose up -d postgres`.
# Dev uses its own database so it never collides with the Docker app's.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/carenovate_dev
# Any long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me
# Public URL of the site (canonical URLs, sitemap, Open Graph)
SITE_URL=http://localhost:3000
# Don't load analytics/marketing scripts here (set to false on production)
DISABLE_ANALYTICS=true
# Hide the whole site from search engines (true for staging/test servers)
NOINDEX=false

# ─── Docker Compose (docker compose up) ──────────────────────────────────────
# compose.yaml reads these too. Set real values on the server.
POSTGRES_PASSWORD=postgres
APP_PORT=3000
